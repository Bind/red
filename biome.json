{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "files": {
    "includes": ["apps/**", "pkg/**", "experiments/**", "!**/dist/**", "!**/build/**", "!**/coverage/**", "!**/sst-env.d.ts"],
    "experimentalScannerIgnores": [
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/sst-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "error",
        "useOptionalChain": "error"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "warn",
        "useNumberNamespace": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noDoubleEquals": "warn",
        "noExplicitAny": "error",
        "useAwait": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.integration.ts",
        "**/*.integration.tsx",
        "**/*.integration.js",
        "**/*.integration.jsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noForEach": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useImportType": "off",
            "useNumberNamespace": "off",
            "useTemplate": "off"
          },
          "suspicious": {
            "noConsole": "off",
            "noDoubleEquals": "off",
            "noExplicitAny": "off",
            "useAwait": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
